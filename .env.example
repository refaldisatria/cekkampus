# Postgres connection (change provider in prisma/schema.prisma to "postgresql")
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/studynook_app?schema=public"

# NextAuth. Generate the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Only these email domains may sign in with Google/Microsoft (comma separated). REQUIRED in production.
ALLOWED_EMAIL_DOMAINS="mail.kampusmu.ac.id,staff.kampusmu.ac.id"

# Google Workspace (optional): Google Cloud Console > Credentials > OAuth client ID (Web)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft 365 Edu (optional): Entra ID > App registrations
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Self-registration with NIM/email + password. Keep "false" unless you add email verification.
ALLOW_REGISTER="false"
