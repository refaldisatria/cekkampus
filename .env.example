# Development (SQLite, no setup needed)
DATABASE_URL="file:./dev.db"

# Production on Vercel: use Postgres (Neon, Supabase, Vercel Postgres) and
# change `provider` in prisma/schema.prisma to "postgresql", e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/studynook?sslmode=require"

# Dummy campus login (simulated SSO). Set to "false" once real SSO is connected.
DEMO_LOGIN="true"
